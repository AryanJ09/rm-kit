 "aiRules": [
  "There is ONE chart component: `Chart`. Never draw bars with rectangles by hand.",
  "Datasets are data. Never create a variant per client, category or metric.",
  "Series colours come only from RM kit chart tokens in `rm-style/ui/chart-series.ts`. Legend and bars read the same token — never set colours separately.",
  "Series order in `series[]` = stack order bottom → top = legend order left → right.",
  "Headline value (e.g. 'Current value') and the chart are INDEPENDENT data. Never compute, reconcile or 'correct' one from the other.",
  "A chart always sits inside a `Card` (pattern=chart). Never place a bare chart on a page.",
  "Always provide `summary` (one-sentence text alternative) for accessibility.",
  "Only `type=stackedBar` is designed. Do not use bar/line/donut until they exist in this spec.",
  "Every segment is separated by a 1px surface.default gap.",
  "Book (RM-level) charts use only book* series; client charts never use book* series.",
  "Percent view (`scale=percent`) is for allocation mix over time; bars always total 100%. Absolute view is for value over time."
 ],
 "decisionTree": [
  {
   "ask": "Showing how a total is made of parts, over time (2–6 periods)?",
   "use": "Chart type=stackedBar"
  },
  {
   "ask": "Only 1–3 numbers, no history?",
   "use": "Card pattern=metric (Card spec)"
  },
  {
   "ask": "Mix / allocation % changing over time?",
   "use": "Chart type=stackedBar scale=percent (e.g. equityAllocation + fixedIncomeAllocation)"
  },
  {
   "ask": "Allocation at ONE point in time (no history)?",
   "use": "not designed — Card pattern=detail rows; donut stays reserved"
  },
  {
   "ask": "More than 6 periods or 5 series?",
   "use": "not supported — aggregate data or ask owner"
  }
 ]
}